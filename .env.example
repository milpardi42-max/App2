EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Development preview only. Keep false for production APK builds.
EXPO_PUBLIC_SKIP_COMPANION_ONBOARDING=false

# Optional on the same Wi-Fi, but required for reliable viewing over mobile/public internet.
EXPO_PUBLIC_TURN_URL=turn:your-turn-server.example.com:3478
EXPO_PUBLIC_TURN_USERNAME=your-turn-username
EXPO_PUBLIC_TURN_CREDENTIAL=your-turn-credential
